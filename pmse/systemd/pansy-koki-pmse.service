[Unit]
Description=Summer XC2 binwise PMSE leakage and Capon screen on Revontuli

[Service]
Type=oneshot
Slice=pansy-koki-pmse.slice
ExecStart=%h/src/pansy_pmse_sparse/pmse/legacy_capon/target/x86_64-unknown-linux-musl/release/pansy-koki-xc2 --input %h/pansy_koki_pmse/context --root /mnt/data/juha/pansy/metadata/xc2 --output %h/pansy_koki_pmse/results --reference %h/src/pansy_spectra_overviews_build --pmse-season --max-output-bytes 400000000
