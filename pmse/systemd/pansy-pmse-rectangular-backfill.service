[Unit]
Description=PANSY oldest-first rectangular replacement backfill (one additional core)

[Service]
Type=simple
WorkingDirectory=/home/radar/src/git/pansy_pmse_sparse
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ExecStart=/home/radar/testenv/bin/python -u -m pmse.rectangular_backfill --output /media/analysis/metadata/pmse_sparse16 --backup-root /media/analysis/metadata/pmse_sparse16_hann_recovery --replace-hann --reserve-free-gib 200
Restart=on-failure
RestartSec=300
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
CPUAffinity=1
MemoryHigh=4G
MemoryMax=6G
TimeoutStopSec=120
