[Unit]
Description=PANSY sparse spectral archive replication from Syowa
After=pansy-backup-tunnel.service
Wants=pansy-backup-tunnel.service

[Service]
Type=simple
WorkingDirectory=/home/j/src/pansy_pmse_sparse
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ExecStart=/home/j/venv/pansy-monitor/bin/python -u -m pmse.replicate_sparse --loop
Restart=on-failure
RestartSec=60
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=default.target
