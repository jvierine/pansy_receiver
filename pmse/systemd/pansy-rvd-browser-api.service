[Unit]
Description=Read-only existing PANSY spectra transport and Rustplotlib axes
After=network-online.target

[Service]
WorkingDirectory=/home/j/src/pansy_pmse_sparse
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/home/j/venv/pansy-monitor/bin/python -u -m pmse.serve_browser
Restart=on-failure
RestartSec=10
Nice=15
CPUQuota=100%
MemoryMax=1G

[Install]
WantedBy=default.target
