# PANSY receiver user-service configuration for syowa-meteor.
#
# Install this file as:
#   ~/.config/pansy-receiver/pansy-receiver.env

PANSY_RECEIVER_REPO=/home/radar/src/git/pansy_receiver
PANSY_UHD_RX_SERVICE=pansy-uhd-rx.service
PANSY_UHD_RX_BINARY=/home/radar/src/git/pansy_receiver/pansy_uhd_rx
PANSY_UHD_RX_OUTDIR=/media/archive
PANSY_UHD_RX_ARGS=
PANSY_TX_XPHASE_SLEEP_SECONDS=60
PANSY_TX_XPHASE_PROGRESS_PATH=/home/radar/.local/state/pansy-receiver/tx_xphase.json
PANSY_TX_XPHASE_METADATA_LAG_SECONDS=5
PANSY_TX_XPHASE_MAX_WINDOWS_PER_PASS=240
PANSY_FIND_MODE_PROGRESS_PATH=/home/radar/.local/state/pansy-receiver/find_mode_starts.json
PANSY_FIND_MODE_RAW_LAG_SECONDS=5
PANSY_FIND_MODE_MAX_WINDOWS_PER_PASS=360
PANSY_FIND_MODE_IDLE_SLEEP_SECONDS=10
PANSY_UHD_RX_LD_LIBRARY_PATH=/home/radar/.syowa/lib

PANSY_PROCESSING_VENV=/home/radar/testenv
PANSY_DELETE_RF_ROOT=/media/archive
PANSY_DELETE_RF_MTIME=+10
PANSY_DELETE_RF_INTERVAL_SECONDS=60

PANSY_WATCH_CHANNELS=ch000,ch001,ch002,ch003,ch004,ch005,ch006,ch007
PANSY_STALE_SECONDS=300
PANSY_CHECK_SECONDS=10
PANSY_RESTART_COOLDOWN_SECONDS=120
PANSY_STOP_TIMEOUT_SECONDS=45
# Allow all four USRP sessions to close before recreating the combined receiver.
PANSY_RESTART_SETTLE_SECONDS=15
PANSY_RESTART_STATE_PATH=/home/radar/.local/state/pansy-receiver/receiver_restart.json

PANSY_PHASE_ROOT=/media/analysis/metadata/phase
PANSY_TX_METADATA_ROOT=/media/analysis/metadata/tx
PANSY_PHASE_MAX_JUMP_DEG=30
PANSY_PHASE_LOOKBACK_DAYS=30
PANSY_PHASE_MIN_BASELINE=10
PANSY_PHASE_CHECK_TIMEOUT_SECONDS=1200
PANSY_PHASE_MAX_RESTARTS=3
PANSY_PHASE_CHECK_SECONDS=60
# Judge only fresh TX pulses after the restarted receiver has settled.
PANSY_PHASE_POST_RESTART_WAIT_SECONDS=90
PANSY_PHASE_RAW_SEARCH_SAMPLES=500000
PANSY_PHASE_RAW_PULSE_SAMPLES=100
PANSY_PHASE_TX_LOOKBACK_SECONDS=600
PANSY_PHASE_MIN_VALID_CHANNELS=7
PANSY_PHASE_MIN_MEAN_AMPLITUDE=1e7
# Known-good raw TX cross-phase relative to ch000, in channel order ch000--ch007.
PANSY_PHASE_REFERENCE_DEG=0.0,-5.4,-6.3,-25.7,-7.4,-4.4,-1.4,-174.0
